# ---------------------------------------------------------------------------
# Android SMS Gateway (capcom6) -- the phone running the app in local mode.
# Find the host/port/credentials on the app's "Local server" screen.
# ---------------------------------------------------------------------------
GATEWAY_SCHEME=http
GATEWAY_HOST=192.168.1.50
GATEWAY_PORT=8080
GATEWAY_USERNAME=sms
GATEWAY_PASSWORD=changeme-from-the-app

# ---------------------------------------------------------------------------
# Basic auth protecting THIS server's REST endpoints. Pick your own values.
# ---------------------------------------------------------------------------
SERVER_USERNAME=admin
SERVER_PASSWORD=change-this-please

# Where this server listens. Pick a port that's free on THIS machine
# (the server checks at startup and refuses to start if it's taken).
SERVER_HOST=0.0.0.0
SERVER_PORT=8200

# ---------------------------------------------------------------------------
# Rate limiting (carrier spam protection).
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_DAY=100
RATE_LIMIT_MIN_INTERVAL_SECONDS=5

# Max delivery attempts per message before it is marked failed.
MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Storage / logging.
# ---------------------------------------------------------------------------
DB_PATH=sms_gateway.db
LOG_FILE=sms_gateway.log
